{
  "name": "signal-bridge",
  "version": "0.1.0",
  "description": "Signal Bridge — multi-service LAN bridge to smart displays (Alexa voice, Tesla, HTTPS Signal UI, discovery, WebView2 push)",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "auth": "node src/auth.js",
    "diagnose": "node src/diagnose.js",
    "diagnose-indoor": "node src/diagnose-indoor.js",
    "tesla-auth": "node src/tesla-auth.js",
    "tesla-auth:code": "node src/tesla-auth.js --code",
    "tesla-register": "node src/tesla-register.js",
    "tesla-verify-register": "node src/tesla-register.js --verify-only",
    "test": "node --test --test-force-exit test/**/*.test.js",
    "test:client": "cd \"alexa broadcast client\" && python -m unittest discover -s test -p test_*.py -v",
    "board-replay": "node src/vestaboard/replay.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "alexa-remote2": "^8.0.4",
    "psn-api": "^2.18.0",
    "ring-client-api": "^14.3.0",
    "sharp": "^0.35.3",
    "ws": "^8.21.3"
  }
}
