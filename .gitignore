.env
*.log

# Local config (use *.example.json as templates)
config.json
alexa broadcast client/config.json

# Bridge runtime data â€” sessions, caches, device inventories, certs, logs.
# Keep the empty directory in git via data/.gitkeep only.
data/**
!data/.gitkeep
broadcast.txt

# Windows broadcast client
alexa broadcast client/.venv/
# Keep Deploy bat / send-test.exe in git; ignore unpacked PyInstaller tree and the portable zip.
# Portable zip is NOT tracked (built on demand; may embed local config).
alexa broadcast client/dist/**
!alexa broadcast client/dist/Deploy Alexa Broadcast Client.bat
!alexa broadcast client/dist/send-test.exe
alexa broadcast client/build/
alexa broadcast client/map-tiles/
alexa broadcast client/trivia-artwork-cache/
alexa broadcast client/map-errors.log
**/__pycache__/
*.pyc
*.pyo

# Huupe device recon. Never commit: the launcher writes the account email, its
# password hash/salt and a signed JWT straight to logcat, so the raw captures
# and the pulled app databases carry real credentials. It is also ~148 MB of
# third-party APKs. The spec beside it is tracked; everything under research
# stays local. Scrubbed excerpts live in test/fixtures/huupe/.
dev assets/huupe_signal_bridge/research/

# Scratch capture files from debugging sessions.
*-test-log*.txt
*-debug*.txt
yt-diag.txt
yt-log.txt
git-diff-capture.txt
sig-commit-msg.txt
bridge-client-test-run.txt
client-test-log.txt

# WikDict SQLite caches used by tools/build-learn-language-words.js
tools/.wikdict/
tools/.enable1/
tools/.wordlists/
tools/.misheard-lyrics/
tools/.word-of-the-day/

