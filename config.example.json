{
  "amazonPage": "amazon.com",
  "acceptLanguage": "en-US",
  "amazonPageProxyLanguage": "en_US",
  "proxyPort": 3456,
  "sessionFile": "data/alexa-session.json",
  "debug": false,
  "udpBroadcast": {
    "enabled": true,
    "port": 47832,
    "discoveryPort": 47833,
    "defaultDisplaySeconds": 120,
    "targets": [],
    "sharedSecret": ""
  },
  "routePlanner": {
    "displaySeconds": null
  },
  "webServer": {
    "enabled": true,
    "port": 47810,
    "https": true,
    "httpRedirectPort": 47811,
    "certDir": "data/web-certs",
    "certHosts": [],
    "controlAuth": {
      "enabled": true,
      "pinDigits": 6,
      "pinDisplaySeconds": null,
      "sessionMinutes": 30
    }
  },
  "qrImage": {
    "cacheDir": "data/qr-image-cache",
    "maxBytes": 6291456
  },
  "slideshow": {
    "settingsFile": "data/slideshow-settings.json"
  },
