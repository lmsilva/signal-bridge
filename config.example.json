{
  "amazonPage": "amazon.com",
  "acceptLanguage": "en-US",
  "amazonPageProxyLanguage": "en_US",
  "proxyPort": 3456,
  "sessionFile": "data/alexa-session.json",
  "debug": false,
  "udpBroadcast": {
    "enabled": true,
    "port": 47832,
    "defaultDisplaySeconds": 120,
    "targets": []
  },
  "voiceEvents": {
    "enabled": true,
    "timeQueries": true,
    "weatherQueries": true,
    "indoorTemperatureQueries": true,
    "airQualityQueries": true,
    "fetchWeather": true,
    "fetchAirQuality": true,
    "fetchIndoorSensor": true,
    "shoppingListQueries": true,
    "musicEvents": true,
    "smartHomeEvents": true,
    "teslaBatteryQueries": true,
    "vivintAlarmQueries": true,
    "notificationQueries": true,
    "eventsLogFile": "data/voice-events.jsonl",
    "defaultLocation": {
      "name": "Home",
      "latitude": 40.0,
      "longitude": -111.0
    }
  },
  "indoorTemperature": {
    "coldBelowF": 68,
    "hotAboveF": 74,
    "locations": []
  },
  "airQuality": {
    "defaultMonitor": "main floor",
    "monitors": []
  },
  "timerSync": {
    "enabled": true,
    "pollIntervalMs": 30000,
    "nearFirePollIntervalMs": 10000,
    "nearFireWindowMs": 120000,
    "fireVerifySlackMs": 30000,
    "mirrorFile": "data/timer-mirror.json"
  },
  "alarmSync": {
    "enabled": true,
    "pollIntervalMs": 60000,
    "mirrorFile": "data/alarm-mirror.json"
  },
  "sessionKeepAlive": {
    "enabled": true,
    "pingIntervalMs": 900000,
    "refreshIntervalMs": 7200000,
    "startupRefreshDelayMs": 180000,
    "proactiveRefreshAfterMs": 28800000,
    "minTokenAgeForRefreshMs": 7200000,
    "staleTokenWatchdogHours": 18,
    "staleNoopRetryMs": 1800000,
    "recommendReauthAfterHours": 16,
    "forceReauthAfterHours": 22,
    "externalRefreshCooldownMs": 60000,
    "reconnectPush": true,
    "failureThreshold": 5,
    "livenessProbe": true,
    "cookieRefreshIntervalMs": 14400000
  }
}
