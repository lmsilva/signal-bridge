    "stateFile": "data/vestaboard-simulator.json"
  },
  "voiceEvents": {
    "enabled": true,
    "timeQueries": true,
    "weatherQueries": true,
    "indoorTemperatureQueries": true,
    "airQualityQueries": true,
    "fetchWeather": true,
    "fetchAirQuality": true,
    "fetchIndoorSensor": true,
    "shoppingListQueries": true,
    "musicEvents": true,
    "smartHomeEvents": true,
    "teslaBatteryQueries": true,
    "teslaDashboardQueries": true,
    "vivintAlarmQueries": true,
    "notificationQueries": true,
