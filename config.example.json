  "backgroundCache": {
    "enabled": true,
    "intervalMs": 3600000,
    "startupDelayMs": 90000,
    "weather": true,
    "shoppingList": true,
    "airQuality": true,
    "tesla": true
  },
  "teslaFleet": {
    "enabled": true,
    "region": "na",
    "domain": "fleetapi.example.com",
    "vin": "",
    "scopes": "openid offline_access vehicle_device_data vehicle_location",
    "sessionFile": "data/tesla-session.json",
    "authStatusFile": "data/tesla-auth-status.json",
    "minRequestIntervalSec": 10,
    "keepAlive": {
      "enabled": true,
      "pingIntervalMs": 900000,
      "refreshWithinMs": 60000,
      "proactiveRefreshAfterMs": 21600000
    }
  },
  "steam": {
    "enabled": true,
    "requirePresence": false,
    "allowedHosts": ["MOVIETHEATERPC"],
