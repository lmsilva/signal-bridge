{
  "amazonPage": "amazon.com",
  "acceptLanguage": "en-US",
  "amazonPageProxyLanguage": "en_US",
  "proxyPort": 3456,
  "broadcastLogFile": "broadcast.txt",
  "sessionFile": "data/alexa-session.json",
  "debug": false,
  "udpBroadcast": {
    "enabled": true,
    "port": 47832,
    "defaultDisplaySeconds": 120,
    "targets": []
  },
  "voiceEvents": {
    "enabled": true,
    "timeQueries": true,
    "weatherQueries": true,
    "fetchWeather": true,
    "eventsLogFile": "data/voice-events.jsonl",
    "defaultLocation": {
      "name": "Home",
      "latitude": 40.0,
      "longitude": -111.0
    }
  },
  "timerSync": {
    "enabled": true,
    "pollIntervalMs": 30000,
    "nearFirePollIntervalMs": 10000,
    "nearFireWindowMs": 120000,
    "fireVerifySlackMs": 30000,
    "mirrorFile": "data/timer-mirror.json"
  },
  "sessionKeepAlive": {
    "enabled": true,
    "pingIntervalMs": 900000,
    "refreshIntervalMs": 10800000,
    "startupRefreshDelayMs": 180000,
    "proactiveRefreshAfterMs": 43200000,
    "minTokenAgeForRefreshMs": 43200000,
    "reconnectPush": true,
    "failureThreshold": 5,
    "livenessProbe": true,
    "cookieRefreshIntervalMs": 14400000
  }
}
