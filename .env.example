# Copy to .env and fill in values. .env is gitignored — never commit secrets.
#
#   cp .env.example .env

# --- Tesla Fleet API (show tesla battery) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_FLEET_DOMAIN=fleetapi.example.com
TESLA_FLEET_REGION=na
# TESLA_VIN=                    # optional; omit to use first vehicle on account
# Public redirect URI registered in the Tesla developer app (exact match required).
# PC OAuth: http://localhost:4381/callback (http:// only allowed for localhost).
# Phone OAuth: https://fleetapi.YOURDOMAIN/callback — Tesla requires a real CA cert domain
# (not a LAN IP). Apache/nginx on that host should proxy /callback → http://NAS:4381/callback.
# The bridge auto-binds plain HTTP :4381 when redirect host is not localhost.
# Optional override: TESLA_CALLBACK_LISTEN=http://0.0.0.0:4381
TESLA_REDIRECT_URI=http://localhost:4381/callback

# --- Signal web UI ---
# Password for https://<NAS>:47810/admin/ (guest photo booth stays at /).
# Required for the admin UI — leave unset and /admin APIs stay locked.
ADMIN_PASSWORD=
# ADMIN_SESSION_HOURS=12

# --- Let's Encrypt HTTPS (Certbot inside the container) ---
# On the QNAP / Docker host (interactive TXT for Whois):
#   ./recreate.sh --build          # once — image includes certbot
#   ./issue-letsencrypt-cert.sh
# Writes data/web-certs/{cert,key}.pem and restarts the container.
# Defaults: signal.wittydigital.com / luismiguelferreirasilva@gmail.com
# Optional PEM path overrides (defaults are data/web-certs/cert.pem + key.pem):
# WEB_TLS_CERT_FILE=
# WEB_TLS_KEY_FILE=

# --- Guest Snaps (Alexa: "open guest snaps") ---
# Dual-QR overlay on all displays: join Wi-Fi, then open the public booth.
# Prefer "guest snaps" — Alexa reserves bare "photobooth" for its own feature.
# After editing these, run ./recreate.sh on the NAS so the container picks them up.
# Optional fallback (bind-mounted): data/guest-photobooth.json
#   { "wifiSsid", "wifiPassword", "boothUrl", "defaultDisplaySeconds" }
GUEST_WIFI_SSID=
GUEST_WIFI_PASSWORD=
# GUEST_WIFI_SECURITY=WPA   # or nopass
# GUEST_WIFI_HIDDEN=0
# GUEST_PHOTOBOOTH_URL is an origin; the booth page itself lives at /guestsnaps/.
# It defaults to https://<PROXY_OWN_IP or webServer.certHosts[0]>:47810 when unset.
# Prefer the Let's Encrypt hostname once you have a real cert:
# GUEST_PHOTOBOOTH_URL=https://signal.wittydigital.com:47810/
# GUEST_PHOTOBOOTH_DISPLAY_SECONDS=180

# --- The Upside News (Guardian Open Platform) ---
# Free key: https://open-platform.theguardian.com/access/
# Preferred for Docker. Takes precedence over a key saved in admin Settings
# (admin Save only writes encrypted data/guardian-credentials.json — never .env).
# GUARDIAN_API_KEY=

# --- Roll Credits (IGDB via Twitch developer apps) ---
# Free Client ID + Secret: https://dev.twitch.tv/console/apps
# Register an application (OAuth Redirect URL can be http://localhost).
# Twitch only issues the keys — Signal talks to IGDB, not Twitch streaming.
# Preferred for Docker. Wins over credentials saved in admin Settings → Roll Credits
# (admin Save returns 409 when these are set). Without them, search still works
# via keyless Steam fallback (thinner metadata).
# After setting: ./recreate.sh --build  (image also needs yt-dlp for YouTube video ingest)
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=

# --- Autodarts (unofficial cloud API — read-only) ---
# Autodarts shut down Keycloak (~2026-06-28). Sign-in is now:
#   POST https://api.autodarts.io/auth/v1/login
#   POST https://api.autodarts.io/auth/v1/device/code (+ /device/token)
#   POST https://api.autodarts.io/auth/v1/refresh
# Device approval UI: https://auth.autodarts.com/link
#
# Default OAuth client id is `darts-caller` (no secret required). The old
# community helper id `developer-darts-caller` is rejected by the new auth
# server — Signal maps it to `darts-caller` automatically.
#
# Preferred day-to-day: Settings → Autodarts → Link (device) or email/password.
# Env vars below still win and block admin overwrite (409) when set.
# AUTODARTS_CLIENT_ID=darts-caller
# AUTODARTS_CLIENT_SECRET=
# AUTODARTS_EMAIL=
# AUTODARTS_PASSWORD=
# Voice: AUTODARTS_QUERIES=0 to disable "show darts" / "darts dashboard" matchers.

# --- Steam Now Playing ---
# Long-lived Web API key from https://steamcommunity.com/dev/apikey
# Preferred source for Docker. Takes precedence over a key saved in admin
# (admin Save key only writes data/steam-session.json — it never updates .env).
# STEAM_API_KEY=
# Optional SteamID64 (otherwise link via admin Settings → Authenticate Steam)
# STEAM_STEAM_ID=
# Steam cannot report which PC is playing. Default: show when the linked
# account is in-game on ANY machine (no software on the gaming PC).
# Typical split: games on MOVIETHEATERPC, overlays on MOVIETHEATERPOSTER.
# STEAM_REQUIRE_PRESENCE=0
# After Alexa/other overlays interrupt Steam, re-show the game card if still
# in-game (seconds). Default 75.
# STEAM_RESTORE_AFTER_INTERRUPT_SEC=75
# When Steam omits gameid, OwnedGames can still open the overlay if last-played
# advanced beyond the idle baseline and is this fresh (default 180). Sessions
# without gameid end if playtime/rtime stop moving (default 150).
# STEAM_INFER_FROM_RECENT_SEC=180
# STEAM_RECENT_PLAY_STAGNANT_SEC=150
# STEAM_RECENT_PLAY_HARD_IDLE_SEC=600
# Optional host gate (only if STEAM_REQUIRE_PRESENCE=1): COMPUTERNAME list.
# STEAM_ALLOWED_HOSTS=MOVIETHEATERPC
# Shared secret for tools/steam-presence-reporter (defaults to STEAM_API_KEY)
# STEAM_PRESENCE_SECRET=
# Public https origin used for OpenID return_to — must be the LAN URL you open
# in the browser (not 127.0.0.1; Docker's loopback breaks the Steam callback).
# With Let's Encrypt, use the hostname (must match the browser origin):
# STEAM_OPENID_REALM=https://signal.wittydigital.com:47810
# Also set PROXY_OWN_IP to the NAS LAN IP if unset.
# STEAM_ENABLED=1

# --- Feature Presentation (Plex → Vestaboard) ---
# Plex Media Server token for the theater Apple TV watcher. Wins over a token
# saved in admin (Save is blocked with 409 when this is set). Never logged.
# PLEX_TOKEN=

# --- LAN UDP encryption (REQUIRED on a real home LAN) ---
# Shared secret for AES-256-GCM on UDP :47832 / :47833 (overlays, remote input,
# display.announce, reboot/power-off). Without this, ANY host on the LAN can
# forge those commands as plaintext. Use a long random string and put the SAME
# value in each display client's config.json as "udpSecret".
# Empty = plaintext (local smoke tests ONLY — not recommended for production).
# After setting: ./recreate.sh and restart/redeploy every display client.
# Generate: openssl rand -base64 32
LAN_UDP_SECRET=

# --- Bridge / Docker (optional overrides) ---
# TZ=America/Denver
# AMAZON_PAGE=amazon.com
# ACCEPT_LANGUAGE=en-US
# DEBUG=0
# PROXY_OWN_IP=192.168.1.10
# PROXY_PORT=3456

# Dumps the raw YouTube Lounge stream (pyytlounge's own DEBUG logger, plus every
# listener callback and each getNowPlaying ack) into `docker logs`. Turn this on
# only when a TV reads `linked` but detects nothing — it is the sole way to tell
# a screen that never heard us from one that heard us and declined. Verbose, and
# `env_file` injects at container create, so it needs `./recreate.sh`.
# YOUTUBE_LOUNGE_DEBUG=1

# --- Flight Plan (AeroDataBox via RapidAPI) ---
# Subscribe at https://rapidapi.com/aedbx-aedbx/api/aerodatabox then paste that key here.
# A generic RAPIDAPI_KEY for another product will NOT work. You can also save the key in
# Settings → Flight Plan instead of using this env var.
# FLIGHTPLAN_RAPIDAPI_KEY=
